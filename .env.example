# ==============================================
# SeatWise environment configuration (template)
# Copy to .env (never commit the real .env file)
# ==============================================

# ---------- Supabase ----------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Public anonymous key (safe for browser; governed by RLS)
SUPABASE_ANON_KEY=
# Service role key (BACKEND ONLY — never expose to the frontend)
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret or JWKS: Supabase projects created recently use asymmetric keys;
# the backend verifies user tokens against SUPABASE_URL/auth/v1/.well-known/jwks.json.
# If your project uses legacy HS256 tokens, set SUPABASE_JWT_SECRET instead.
SUPABASE_JWT_SECRET=

# ---------- Backend ----------
# Comma-separated origins allowed to call the API
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where the API is mounted (default /api)
API_V1_PREFIX=/api
# Solver time limit per seating generation, in seconds
SOLVER_TIME_LIMIT_SECONDS=20

# ---------- Frontend (Vite: only VITE_* vars reach the browser) ----------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
