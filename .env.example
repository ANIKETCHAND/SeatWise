# ==============================================================================
# SeatWise — Smart Examination Seating Management System
# Environment Configuration Template
# Copy this file to `.env` for local development or configure in your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Diagnostics
# ------------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Supabase Integration
# ------------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Public anonymous key (governed by Row Level Security; safe for client side)
SUPABASE_ANON_KEY=

# Service role key (BACKEND ONLY — bypasses RLS for administrative batch allocation)
# NEVER expose this key to client-side code or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret:
# Modern Supabase projects use asymmetric RS256/ES256 keys; the backend verifies
# user JWTs against $SUPABASE_URL/auth/v1/.well-known/jwks.json.
# If your Supabase instance uses legacy symmetric HS256 tokens, provide the secret here.
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# 3. Backend (FastAPI Python)
# ------------------------------------------------------------------------------
# Server port for local FastAPI execution (default 8000)
PORT=8000

# Prefix for all REST API endpoints
API_V1_PREFIX=/api

# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://localhost:8080,https://seatwise-fet.vercel.app,https://seatwise-portal.vercel.app,https://seatwise-ju.vercel.app,https://seatwise-exam.vercel.app,https://seatwise-ctl8.vercel.app,https://seatwise.vercel.app,https://frontend-lyart-nu-63.vercel.app

# OR-Tools CP-SAT discrete optimization solver cutoff timeout in seconds
SOLVER_TIME_LIMIT_SECONDS=20

# ------------------------------------------------------------------------------
# 4. Frontend (Vite + React + TypeScript)
# Note: Vite exclusively exposes variables prefixed with `VITE_` to the browser.
# ------------------------------------------------------------------------------
# Target API root for all HTTP requests
VITE_API_BASE_URL=http://localhost:8000/api

# Frontend Supabase client credentials (optional for offline mock mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth 2.0 Client ID for Google Identity Services
VITE_GOOGLE_CLIENT_ID=583335952268-dlt9d2nqr43ord4tkgdmotqd4103lumq.apps.googleusercontent.com
